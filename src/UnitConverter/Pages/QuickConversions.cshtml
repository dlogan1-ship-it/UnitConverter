@page
@model QuickConversionsModel

<h1>Quick Conversions</h1>

<form method="get" asp-page-handler="@ConversionTypes.MilesToKilometers">
    <input type="hidden" name="handler" value="@ConversionTypes.MilesToKilometers" />
    <div class="mb-3">
        <label for="miles" class="form-label">Miles</label>
        <input id="miles" name="input" type="text" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Convert miles to kilometers</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.KilometersToMiles">
    <input type="hidden" name="handler" value="@ConversionTypes.KilometersToMiles" />
    <div class="mb-3">
        <label for="kilometers" class="form-label">Kilometers</label>
        <input id="kilometers" name="input" type="number" step="any" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Convert kilometers to miles</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.FahrenheitToCelsius">
    <input type="hidden" name="handler" value="@ConversionTypes.FahrenheitToCelsius" />
    <div class="mb-3">
        <label for="fahrenheit" class="form-label">Degrees Fahrenheit</label>
        <textarea id="fahrenheit" name="input" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Convert Fahrenheit to Celsius</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.CelsiusToFahrenheit">
    <input type="hidden" name="handler" value="@ConversionTypes.CelsiusToFahrenheit" />
    <div class="mb-3">
        <label for="celsius" class="form-label">Degrees Celsius (-50 to 50)</label>
        <input id="celsius" name="input" type="range" min="-50" max="50" class="form-range" />
    </div>
    <button type="submit" class="btn btn-primary">Convert Celsius to Fahrenheit</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.PoundsToKilograms">
    <input type="hidden" name="handler" value="@ConversionTypes.PoundsToKilograms" />
    <div class="mb-3">
        <label for="pounds" class="form-label">Pounds</label>
        <select id="pounds" name="input" asp-items="Model.PoundOptions" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-primary">Convert pounds to kilograms</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.KilogramsToPounds">
    <input type="hidden" name="handler" value="@ConversionTypes.KilogramsToPounds" />
    <div class="mb-3">
        <label for="kilograms" class="form-label">Kilograms</label>
        <input id="kilograms" name="input" type="number" step="any" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Convert kilograms to pounds</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.GallonsToLiters">
    <input type="hidden" name="handler" value="@ConversionTypes.GallonsToLiters" />
    <div class="mb-3">
        <label for="gallons" class="form-label">Gallons</label>
        <input id="gallons" name="input" type="number" step="any" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Convert gallons to liters</button>
</form>

<form method="get" asp-page-handler="@ConversionTypes.AcresToHectares">
    <input type="hidden" name="handler" value="@ConversionTypes.AcresToHectares" />
    <div class="mb-3">
        <label for="acres" class="form-label">Acres</label>
        <input id="acres" name="input" type="number" step="any" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Convert acres to hectares</button>
</form>

<a asp-page="/Index">Back to Home</a>
